{
  "consumer": {
    "name": "reservation-consumer"
  },
  "interactions": [
    {
      "description": "a request for a missing SKU",
      "providerStates": [
        {
          "name": "sku_not_found"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/inventory/Z999"
      },
      "response": {
        "body": {
          "code": "SKU_NOT_FOUND",
          "message": "SKU Z999 not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "SKU [A-Z0-9]+ not found"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request for a stockless SKU",
      "providerStates": [
        {
          "name": "out_of_stock"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/inventory/B200"
      },
      "response": {
        "body": {
          "availableQuantity": 0,
          "name": "Mouse Pro",
          "price": 45,
          "sku": "B200",
          "status": "OUT_OF_STOCK"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.availableQuantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for an available SKU",
      "providerStates": [
        {
          "name": "available_stock"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/inventory/A100"
      },
      "response": {
        "body": {
          "availableQuantity": 8,
          "name": "Laptop Ultra",
          "price": 1200,
          "sku": "A100",
          "status": "AVAILABLE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.availableQuantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "15.0.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "inventory-provider"
  }
}